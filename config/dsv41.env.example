# =============================================================================
# Example configuration for vllm-ascend-deepseek-v41-a3
#
# Copy to config/dsv41.local.env (machine-specific, gitignored). It is sourced
# as shell. config/dsv41.env is also supported and ignored by git.
#
# Environment variables exported by the caller always win.
# =============================================================================

# ---- runtime ---------------------------------------------------------------
# native: run the extracted rootfs directly on the host (host glibc >= 2.35).
# docker: run inside a container from a locally loaded image — required on older
#         hosts (e.g. Kylin V10, glibc 2.28) and for air-gapped nodes. See
#         config/dsv41.docker.env.example and docs/offline-deployment.md.
# DSV41_RUNTIME=native

# ---- locations -------------------------------------------------------------
# Root filesystem extracted from quay.nju.edu.cn/ascend/vllm-ascend:v0.30.0rc2-a3
# (native runtime only; ignored with DSV41_RUNTIME=docker)
DSV41_ROOTFS=/cache/dsv41-rc2-rootfs

# DeepSeek-V4.1-Flash-1017-w8a8 weights (ModelSlim W8A8_DYNAMIC).
# Default when unset: <repo>/models/DeepSeek-V4.1-Flash-1017-w8a8
DSV41_MODEL=/cache/models/DeepSeek-V4.1-Flash-1017-w8a8

# Optional: override auto-detection inside the rootfs.
# DSV41_PYTHONHOME=/cache/dsv41-rc2-rootfs/usr/local/python3.12.13
# DSV41_CANN_HOME=/cache/dsv41-rc2-rootfs/usr/local/Ascend/cann-9.2.0

# Runtime logs and pid files.
DSV41_RESULTS=/var/log/dsv41
DSV41_LOG_DIR=/var/log/dsv41
DSV41_PID_DIR=/run/dsv41

# ---- service ---------------------------------------------------------------
DSV41_HOST=0.0.0.0
DSV41_PORT=8021
DSV41_SERVED_NAME=DeepSeek-V4.1-Flash-1017
DSV41_DP=2
DSV41_TP=8

# ---- routing ---------------------------------------------------------------
# internal: single endpoint, vLLM load-aware DP routing (no prefix affinity)
# external: multi-port DP servers + scripts/prefix_router.py (prefix/KV-aware)
DSV41_LB_MODE=external
# External mode ports: router=DSV41_PORT, supervisor=8020, ranks=8022/8023.
DSV41_DP_SUPERVISOR_PORT=8020
DSV41_DP_BASE_PORT=8022
DSV41_KV_EVENTS=1
DSV41_KV_EVENTS_BASE_PORT=5557

# Router policy. cost (default) scores each rank in tokens: uncached prompt + queued
# prefill + a penalty for a KV-saturated / queueing rank (scraped from /metrics).
# legacy = longest prefix wins unless the active-request gap exceeds DSV41_ROUTER_MAX_SKEW.
# Roll back with:  DSV41_ROUTER_POLICY=legacy ROUTER_RESTART=1 bash scripts/serve.sh
DSV41_ROUTER_POLICY=cost
DSV41_ROUTER_KV_HIGH=0.90
DSV41_ROUTER_SAT_PENALTY=32768
DSV41_ROUTER_PREFILL_WEIGHT=0.5
DSV41_ROUTER_LOAD_INTERVAL=2
DSV41_ROUTER_MAX_SKEW=8

# Bearer token required when non-empty. Leave empty only for loopback tests.
DSV41_API_KEY=change-me-to-a-long-random-string

# ---- model / scheduler -----------------------------------------------------
DSV41_MAX_MODEL_LEN=1048576
DSV41_MAX_NUM_BATCHED_TOKENS=16384
DSV41_MAX_NUM_SEQS=32
DSV41_GPU_MEM_UTIL=0.90
DSV41_BLOCK_SIZE=128
DSV41_ENABLE_PREFIX_CACHING=1
DSV41_ENABLE_EXPERT_PARALLEL=1
# --enable-prompt-tokens-details: usage.prompt_tokens_details.cached_tokens in responses.
DSV41_ENABLE_PROMPT_TOKENS_DETAILS=1
# 1 → HF_HUB_OFFLINE / TRANSFORMERS_OFFLINE / VLLM_NO_USAGE_STATS … (air-gapped nodes).
DSV41_OFFLINE=1

# ---- speculative decoding --------------------------------------------------
# DSpark is trained as 5-token blocks; larger K measured slower.
DSV41_SPEC_TOKENS=5

# 37 ACL-graph buckets. The 6N entries are required so the draft model stays
# inside the graph (num_reqs * (1 + K) tokens per step → multiples of 6).
DSV41_CUDAGRAPH_SIZES=1,2,4,6,8,12,16,18,24,30,32,40,48,54,56,64,72,78,80,88,96,102,104,112,120,126,128,136,144,150,152,160,168,174,176,184,192

# ---- optional stream core budget (A3 only) --------------------------------
# Requires scripts/patches/experimental/0202-limit-core-num.patch applied to the
# rootfs tree. Main stream is cube-dense, overlap stream is vector-dense; giving
# the overlap stream its own vector budget measured +3~6% single-stream decode
# (2026-11-12). 0 = disabled (upstream behaviour).
# DSV41_LIMIT_CORE_MAIN_AIV=16
# DSV41_LIMIT_CORE_AUX_AIV=32
# DSV41_LIMIT_CORE_AIC=24

# ---- runtime knobs ---------------------------------------------------------
DSV41_USE_V2=1
DSV41_HCCL_BUFFSIZE=512
DSV41_HCCL_OP_EXPANSION_MODE=AIV
DSV41_SAFETENSORS_LOAD_STRATEGY=lazy
DSV41_LOADER_THREADS=128
DSV41_ENGINE_READY_TIMEOUT_S=36000

# ---- watchdog --------------------------------------------------------------
DSV41_CHECK_INTERVAL=30
DSV41_HEALTH_TIMEOUT=10
DSV41_GRACE_PERIOD=180
DSV41_STARTUP_TIMEOUT=3600
DSV41_STARTUP_POLL=15
DSV41_FAILURE_COOLDOWN=120
# Abort a restart quickly when serve.sh exits during startup.
DSV41_STARTUP_FAIL_FAST=120

# Refuse to start when the port already has a vLLM instance (recommended).
DSV41_ALLOW_MULTI=0

# Cleanup (watchdog restarts, STOP=1, kill_vllm.sh) only touches THIS deployment's
# processes (tagged by serve.sh), so other vLLM / NPU jobs on the node survive.
# Set to 1 only on a dedicated node to also kill every VLLM:: process.
DSV41_CLEAN_ALL_VLLM=0

# ---- external KV pool (AscendStoreConnector + MemCache) --------------------
# Opt-in (0 = previous behaviour). This follows the reference deployment
# CJYLZS/vllm-ascend-deepseek-v41-a2: AscendStoreConnector + memcache_hybrid
# MetaService over host shared memory. It does not use Mooncake/HIXL, so the
# A3 cross-card halDeviceDisableP2P failure is avoided entirely.
# Details + capacity math: docs/kv-pool.md
DSV41_KV_POOL=0
# Host DRAM registered by EACH rank (16 dies × 2 GB = 32 GiB total by default).
# The MetaService itself is CPU-only and consumes no HBM.
# `bash scripts/kvpool.sh check-capacity` enforces the budget before every launch.
DSV41_KV_DRAM_GB=2
# host_shm is the only transport validated in this image. Do not use
# host_rdma (0-byte extend library) or device_rdma (segfault at 8+ ranks).
DSV41_KV_PROTOCOL=host_shm
# memcache_hybrid local-service world size (ranks that may register).
DSV41_KV_WORLD_SIZE=256
# MetaService endpoints. None may collide with the vLLM --port.
DSV41_KV_META_PORT=5100
DSV41_KV_STORE_PORT=6100
DSV41_KV_METRICS_PORT=8100
# Preflight budget: keep this much RAM free, and never let the pool exceed this
# share of MemTotal (both checked by `bash scripts/kvpool.sh check-capacity`).
DSV41_KVPOOL_MIN_FREE_GIB=64
DSV41_KVPOOL_MAX_MEM_PCT=25
# 0101 (MRV2 preemption marker) is a correctness gate. Leave this at 0: without
# 0101 a preempted request can associate the wrong blocks with pool keys, and
# the engine silently returns wrong output. 1 = run anyway (not recommended).
DSV41_KV_ALLOW_UNFIXED_TREE=0
# 1 → STOP=1 also stops a MetaService started by scripts/kvpool.sh.
DSV41_KVPOOL_STOP_WITH_SERVE=0
