+# --- optional per-stream core budget (env-gated, default off) ----------------
+# Ported from the CANN low-latency recipe (A3 only): the main stream here is
+# cube-dense (wq_a/wq_b matmuls) while the overlap stream is vector-dense
+# (quantize / kv_norm / RoPE / SWA write), so the vector-core budget can be
+# partitioned between the two streams.  Defaults keep the original behaviour.
+import os as _os
+
+_LIMIT_CORE_MAIN_AIV = int(_os.environ.get("VLLM_ASCEND_V41_LIMIT_CORE_MAIN_AIV", "0") or 0)
