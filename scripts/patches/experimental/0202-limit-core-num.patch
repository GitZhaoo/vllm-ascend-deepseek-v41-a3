+_LIMIT_CORE_AIC = int(_os.environ.get("VLLM_ASCEND_V41_LIMIT_CORE_AIC", "0") or 0)
+
+
+@contextmanager
+def _limit_core(aiv: int, stream=None):
+    """Restrict the cube/vector core budget of a stream for enclosed ops."""
+    if aiv <= 0:
+        yield
+        return
+    try:
+        from torch.npu.npugraph_ex.scope import limit_core_num
+    except Exception:  # pragma: no cover - older torch_npu
+        yield
+        return
+    aic = _LIMIT_CORE_AIC if _LIMIT_CORE_AIC > 0 else 24
+    with limit_core_num(aic, aiv, stream):
+        yield
