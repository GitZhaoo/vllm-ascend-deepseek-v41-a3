# exp60 — TASK_QUEUE_ENABLE=1 显式锁定（预期 null，用于排除「我们没设」的疑虑）
# 机理: torch_npu 异步任务队列，把下发从主线程剥离；=2 与图捕获不兼容（实测 CAPTURE_FAIL）。
# ★ 实测现状: 本机 pid1(systemd) 环境里已有 TASK_QUEUE_ENABLE=1 和 OMP_NUM_THREADS=1
#   （/proc/1/environ），因此现有引擎进程已继承 =1（/proc/<engine>/environ 可见），
#   并不是「我们没设」；本 overlay 只是把该值写死，防止将来从 systemd/干净环境起服时丢失。
# 预期: 【实测·env】ms/step 0（已经开着）；若 A/B 真测出差异，说明继承链断过，值得固化。
# 风险: 无（=1 与 FULL 图兼容，repo1 实测 CAPTURE_OK/REPLAY_OK）。
# 依据: /tmp/refs/a/docs/V41-DCP8-DECODE-PERF-20261002.md:283-296（=2 不兼容）；
#       extra-info/ref-repos-study.md:407-409（repo2 设 =1）；本机 pid1/engine env 实测。
TASK_QUEUE_ENABLE=1
# 不要设 OMP_NUM_THREADS>1：vLLM 在稳态会主动把 torch 线程降到 1，
# 外部设 >1 会触发 spin-wait 争用告警且可能拖慢（vllm/utils/torch_utils.py:259-295）。
