# production-parity measurement: KV pool ON (16 x 32 GB) + fusion patches (default on)
# + engram overlap, production BAT/max_seqs/buckets unchanged.
DSV41_KV_POOL=1
DSV41_KV_DRAM_GB=32
DSV41_KVPOOL_MAX_MEM_PCT=30
EXP_READY_ITERS=300
EXP_DUAL_CONCURRENCY=2,4,8,16,32,64
EXP_BENCH_REPEATS=3
DSV41_EXTRA_SERVE_ARGS='--additional-config {"enable_cpu_binding":true,"enable_prefill_mc2":false,"enable_fused_mc2":0,"multistream_overlap_shared_expert":true,"multistream_engram_overlap":true,"ascend_compilation_config":{"enable_npugraph_ex":false,"enable_static_kernel":false}}'
VLLM_ASCEND_V41_KVPOOL_SKIP_LOCAL_LOOKUP=1
VLLM_ASCEND_V41_KVPOOL_BATCH_LOOKUP=1
