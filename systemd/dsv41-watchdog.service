[Unit]
Description=DeepSeek-V4.1-Flash-1017 w8a8 watchdog (vLLM Ascend A3)
Documentation=file:///opt/vllm-ascend-deepseek-v41-a3/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=root
WorkingDirectory=/opt/vllm-ascend-deepseek-v41-a3
EnvironmentFile=-/etc/dsv41.env
RuntimeDirectory=dsv41
RuntimeDirectoryMode=0755
PIDFile=/run/dsv41/dsv41_watchdog.pid
ExecStart=/bin/bash /opt/vllm-ascend-deepseek-v41-a3/scripts/watchdog.sh start
ExecStop=/bin/bash /opt/vllm-ascend-deepseek-v41-a3/scripts/watchdog.sh stop
RemainAfterExit=yes
TimeoutStartSec=60
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
