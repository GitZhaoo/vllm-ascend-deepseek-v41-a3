[Unit]
Description=DeepSeek-V4.1-Flash-1017 w8a8 server (vLLM Ascend A3)
Documentation=file:///opt/vllm-ascend-deepseek-v41-a3/README.md
After=network-online.target
Wants=network-online.target
# Usually the watchdog unit is used instead; enabling both is unnecessary.

[Service]
Type=forking
User=root
WorkingDirectory=/opt/vllm-ascend-deepseek-v41-a3
EnvironmentFile=-/etc/dsv41.env
RuntimeDirectory=dsv41
RuntimeDirectoryMode=0755
PIDFile=/run/dsv41/dsv41_serve.pid
ExecStart=/bin/bash /opt/vllm-ascend-deepseek-v41-a3/scripts/serve.sh
ExecStop=/bin/bash -c 'STOP=1 /bin/bash /opt/vllm-ascend-deepseek-v41-a3/scripts/serve.sh'
TimeoutStartSec=120
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
